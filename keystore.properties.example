# Copy this file to keystore.properties and fill in your own values.
# keystore.properties and the .jks file are git-ignored and must NEVER be committed.
#
# Generate the keystore once with:  bash scripts/generate_keystore.sh
# Back it up in at least three places. If you lose it you cannot update the app.
#
# For the GitHub Actions release workflow, add these four repository secrets:
#   KEYSTORE_BASE64     -> base64 -w0 release-keystore.jks
#   KEYSTORE_PASSWORD   -> your store password
#   KEY_ALIAS           -> bharat-suraksha
#   KEY_PASSWORD        -> your key password
storeFile=../release-keystore.jks
storePassword=CHANGE_ME
keyAlias=bharat-suraksha
keyPassword=CHANGE_ME
